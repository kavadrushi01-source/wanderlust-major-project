<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-6 offset-3">
            <h3>
                <%= listing.title %>
            </h3>

            <div class="card show-card">
                <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image">
                <div class="card-body">
                    <p class="card-text">
                        <%= listing.description %> <br>
                        <span class="price-without-tax">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span>
                        <span class="price-with-tax">&#8377; <%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : "N/A" %> <small class="text-muted">(incl. 18% tax)</small></span>
                        <br>
                            <%= listing.location %> <br>
                                <%= listing.country %> <br>
                                <% if(listing.owner) { %>
                                    <small class="text-muted">Owned by <%= listing.owner.username %></small>
                                <% } %>
                    </p>
                </div>
            </div>

            <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                <div class="btns mt-3">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn me-2">Edit</a>
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            <% } %>

            <div class="mt-3 mb-3">
                <h5>Where you'll be</h5>
                <div id="showMap" class="show-map"></div>
            </div>
            <hr>
            <div class="mb-3">
                <% if(currUser) { %>
                    <h4>Leave a Review</h4>
                    <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
                        <div class="mb-3 mt-3">
                            <label class="form-label">Rating</label>
                            <div class="star-rating-input" id="starRating">
                                <i class="fa-regular fa-star" data-value="1"></i>
                                <i class="fa-regular fa-star" data-value="2"></i>
                                <i class="fa-regular fa-star" data-value="3"></i>
                                <i class="fa-regular fa-star" data-value="4"></i>
                                <i class="fa-regular fa-star" data-value="5"></i>
                            </div>
                            <input type="hidden" name="review[rating]" id="ratingValue" required>
                            <div class="invalid-feedback">Please select a rating</div>
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comment</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                required></textarea>
                            <div class="invalid-feedback">
                                Please add some comment for review
                            </div>
                        </div>
                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                <% } %>
            </div>
            <hr>

            <h4 class="mb-3">All Reviews</h4>
            <% if(listing.reviews.length === 0) { %>
                <p class="text-muted">No reviews yet. Be the first to leave one!</p>
            <% } %>
            <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
                <% for(let review of listing.reviews) { %>
                    <div class="col">
                        <div class="card review-card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="review-avatar me-2"><%= review.author ? review.author.username.charAt(0).toUpperCase() : 'A' %></div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold review-name"><%= review.author ? review.author.username : 'Anonymous' %></div>
                                        <div class="review-stars text-warning">
                                            <% for(let i = 1; i <= 5; i++) { %>
                                                <% if(i <= review.rating) { %>
                                                    <i class="fa-solid fa-star"></i>
                                                <% } else { %>
                                                    <i class="fa-regular fa-star"></i>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </div>
                                    <small class="text-muted review-date">
                                        <%= review.createdAt ? review.createdAt.toDateString() : '' %>
                                    </small>
                                </div>
                                <p class="card-text mb-0 review-comment">
                                    <%= review.comment %>
                                </p>
                                <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="post" class="text-end mt-2">
                                        <button class="btn btn-sm review-delete-btn" title="Delete review">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        const showMapCoords = <%- JSON.stringify(mapCoords) %>;
        const hasShowCoords = showMapCoords.lat !== 0 || showMapCoords.lng !== 0;

        const showMap = L.map('showMap').setView(hasShowCoords ? [showMapCoords.lat, showMapCoords.lng] : [20, 0], hasShowCoords ? 12 : 2);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(showMap);

        if (hasShowCoords) {
            const listingMarker = L.marker([showMapCoords.lat, showMapCoords.lng]).addTo(showMap);
            listingMarker.bindPopup(`<strong><%= listing.title %></strong><br><%= listing.location %>, <%= listing.country %>`).openPopup();
        }

        const starContainer = document.getElementById('starRating');
        const ratingInput = document.getElementById('ratingValue');
        if (starContainer) {
            const stars = starContainer.querySelectorAll('i');
            stars.forEach(star => {
                star.addEventListener('click', () => {
                    const val = star.getAttribute('data-value');
                    ratingInput.value = val;
                    stars.forEach(s => {
                        if (s.getAttribute('data-value') <= val) {
                            s.classList.remove('fa-regular');
                            s.classList.add('fa-solid');
                        } else {
                            s.classList.remove('fa-solid');
                            s.classList.add('fa-regular');
                        }
                    });
                });
                star.addEventListener('mouseenter', () => {
                    const val = star.getAttribute('data-value');
                    stars.forEach(s => {
                        if (s.getAttribute('data-value') <= val) {
                            s.classList.remove('fa-regular');
                            s.classList.add('fa-solid');
                        }
                    });
                });
                star.addEventListener('mouseleave', () => {
                    const val = ratingInput.value || 0;
                    stars.forEach(s => {
                        if (s.getAttribute('data-value') <= val) {
                            s.classList.remove('fa-regular');
                            s.classList.add('fa-solid');
                        } else {
                            s.classList.remove('fa-solid');
                            s.classList.add('fa-regular');
                        }
                    });
                });
            });
        }
    </script>
